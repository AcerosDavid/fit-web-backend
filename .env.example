# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (PostgreSQL - usado por docker-compose) ─────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fit_gym
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ─── Database (URL única - Render / Neon / Supabase) ──────────────────────────
# Si se define, tiene prioridad sobre el bloque DB_* anterior.
# En Render se inyecta automáticamente desde render.yaml.
# DATABASE_URL=postgresql://usuario:password@host:5432/base?sslmode=require

# ─── CORS (frontend en producción) ────────────────────────────────────────────
# Origen exacto del frontend, sin barra final. Separar varios con coma.
# CORS_ALLOWED_ORIGINS=https://fit-web-frontend.onrender.com

# ─── Producción en Render ─────────────────────────────────────────────────────
# Render define RENDER_EXTERNAL_HOSTNAME automáticamente.
# ALLOWED_HOSTS no necesita incluir el dominio de Render.
# WEB_CONCURRENCY=2

# ─── Database (SQLite - ejecución local sin Docker) ───────────────────────────
# Comenta el bloque anterior y descomenta este si corres `manage.py` en local.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_HOST=localhost

# ─── Opcionales ───────────────────────────────────────────────────────────────
# WEB_PORT=8000      # Puerto del API en el host (docker-compose)
# DB_HOST_PORT=5434  # Puerto de PostgreSQL en el host (solo compose dev)
# ADMINER_PORT=8081  # Puerto de Adminer en el host (solo compose dev)
