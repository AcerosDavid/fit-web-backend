# Copy this file to .env and fill in the values
# cp .env.example .env

# ─── Application ──────────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database (PostgreSQL - usado por docker-compose) ─────────────────────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=fit_gym
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# ─── Database (SQLite - ejecución local sin Docker) ───────────────────────────
# Comenta el bloque anterior y descomenta este si corres `manage.py` en local.
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3
# DB_HOST=localhost

# ─── Opcionales ───────────────────────────────────────────────────────────────
# WEB_PORT=8000      # Puerto del API en el host (docker-compose)
# DB_HOST_PORT=5434  # Puerto de PostgreSQL en el host (solo compose dev)
# ADMINER_PORT=8081  # Puerto de Adminer en el host (solo compose dev)
